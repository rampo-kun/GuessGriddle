+@theme inline{--color-background:var(--background);--color-foreground:var(--foreground);--font-sans:var(--font-geist-sans);--font-mono:var(--font-geist-mono)}
+*{box-sizing:border-box}html{min-height:100%;background:var(--cream)}
+body{min-height:100%;margin:0;color:var(--charcoal);background:radial-gradient(ellipse at 12% 8%,rgba(233,185,73,.18),transparent 30%),radial-gradient(ellipse at 90% 85%,rgba(200,61,45,.09),transparent 32%),var(--cream);font-family:Arial,Helvetica,sans-serif;background-attachment:fixed}
+::selection{background:var(--mustard);color:var(--charcoal)}
+/* Warm-paper surfaces replace the starter dark SaaS palette. */
+.bg-slate-950{background-color:var(--cream)!important;color:var(--charcoal)!important}.bg-slate-900{background-color:var(--paper)!important}.bg-slate-800{background-color:var(--paper-deep)!important}.bg-slate-900\/90{background-color:rgba(255,247,232,.94)!important}
